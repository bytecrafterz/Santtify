# Configuração de produção.
#
#   cp deploy/.env.production.exemplo .env.production
#
# Este arquivo NÃO vai para o git. Ele contém os segredos do servidor.
#
# Para gerar os segredos:
#
#   # A senha do banco entra DENTRO de um endereço de conexão, então não pode
#   # ter /, +, @ nem :. Em hexadecimal isso nunca acontece.
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#
#   # Os três abaixo não vão em endereço nenhum: base64 serve e é mais forte
#   # por caractere.
#   for v in JWT_ACCESS_SECRET JWT_REFRESH_SECRET PRIVACY_HASH_SALT; do
#     echo "$v=$(openssl rand -base64 32)"
#   done
#
# ────────────────────────────────────────────────────────────────────

# O domínio, sem https:// e sem barra no fim. É daqui que sai o certificado.
DOMINIO=santtify.com

# ── Banco ───────────────────────────────────────────────────────────
POSTGRES_USER=produtovivo
POSTGRES_DB=produtovivo
# Gere com: openssl rand -hex 24
#
# SÓ letras e números. Esta senha é montada dentro do endereço de conexão do
# banco, e uma barra ou um arroba no meio dela quebram a leitura do endereço:
# a API sobe, tenta migrar e morre com "invalid port number in database URL",
# uma mensagem que não tem nada a ver com a causa.
POSTGRES_PASSWORD=TROQUE_ISTO

# ── Segredos ────────────────────────────────────────────────────────
# Cada um com no mínimo 16 caracteres. A API se recusa a subir sem eles.
JWT_ACCESS_SECRET=TROQUE_ISTO
JWT_REFRESH_SECRET=TROQUE_ISTO

# Sal do hash de IP e user-agent.
#
# CUIDADO AO TROCAR DEPOIS DO LANÇAMENTO: os hashes antigos deixam de
# corresponder aos novos, e a mesma pessoa passa a contar como duas. Trocar isto
# reescreve o significado do histórico sem apagar uma linha sequer.
PRIVACY_HASH_SALT=TROQUE_ISTO

# ── Privacidade ─────────────────────────────────────────────────────
# 1095 dias = 3 anos. Precisa bater com RETENCAO_EVENTOS_DIAS em
# apps/web/src/lib/legal.ts, senão a política promete uma coisa e o sistema faz
# outra.
EVENT_RETENTION_DAYS=1095
# Igual a VERSAO_DA_POLITICA em apps/web/src/lib/legal.ts.
CONSENT_POLICY_VERSION=1.0.0

# ── Aplicação ───────────────────────────────────────────────────────
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
NEXT_PUBLIC_PROJETO_PADRAO=jesus-alfabeto-saudavel
# Link de convite do grupo do Produto Vivo, no formato
# https://chat.whatsapp.com/CODIGO
#
# É um grupo, e não o telefone dele, por decisão de 15/08: centraliza as
# respostas e evita publicar o número pessoal numa página aberta. Se o grupo
# receber spam, ele reseta o convite no WhatsApp e só esta linha muda.
NEXT_PUBLIC_PV_GRUPO_URL=

# ── Backup ──────────────────────────────────────────────────────────
# Dias de cópia mantidos no servidor. O log de eventos é o único dado que não
# pode ser recriado.
BACKUP_RETENCAO_DIAS=14

# ── Login com Google (quando o cliente enviar) ──────────────────────
# Criados por ele no console.cloud.google.com, na conta dele.
# O endereço de retorno precisa ser exatamente:
#   https://SEU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Envio de e-mail (reposição de senha) ────────────────────────────
# Conta gratuita em brevo.com. A chave fica SÓ aqui, nunca no repositório.
#
# O remetente tem de estar VERIFICADO no Brevo, ou autenticado por domínio.
# Sem domínio autenticado o envio sai na mesma, mas cai em spam com muita
# facilidade — o Gmail confere SPF e DKIM antes de decidir.
BREVO_API_KEY=
MAIL_REMETENTE=
MAIL_REMETENTE_NOME=Santtify

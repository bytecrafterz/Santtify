node_modules/
.env
.env.local
.env.*.local
# Segredos de produção: senha do banco, chaves JWT e o sal dos hashes.
# Comitar este arquivo é entregar o servidor junto com o código.
.env.production
.env.production.*
# Cópias de mão do .env. Uma delas foi parar ao histórico com os segredos
# de desenvolvimento lá dentro, e o padrão acima não a apanhava.
.env.bak
.env.*.bak
*.env.bak
!deploy/.env.production.exemplo
dist/
build/
.next/
out/
coverage/
*.log
.DS_Store
.turbo/
.prisma/
uploads/
tsconfig.tsbuildinfo

# Arte enviada pelo cliente: fica no armazenamento de mídia, não no histórico.
# São 26 arquivos de ~10 MB — em git eles ficariam para sempre, mesmo apagados.
*.jpeg
*.jpg
!apps/web/public/*.jpg
IMG_*.png
ABBC*.png

# Mockups e artes que o cliente envia por chat: material dele, não do código.
*.png
*.jpeg
!apps/web/public/*.png

# A conversa com o cliente não entra no repositório.
#
# O histórico do git é permanente e público para quem tiver acesso ao
# repositório. Uma conversa comercial inteira lá dentro, com valores, disputas e
# nomes, não se tira depois. É a mesma regra do número de telefone dele.
chatting_history.txt
*chatting_history*
conversa-*.txt

# Fotos de crianças e PDFs em trânsito. Nunca versionar.
cartoes-temporarios/

# Notas de voz e ficheiros que o cliente manda pelo WhatsApp: entram em docs/
# por conveniencia, mas nao sao fonte deste projeto.
docs/audio*.mpeg
docs/audio*.ogg
docs/audio*.m4a

# Os áudios que ele manda por WhatsApp para eu carregar como conteúdo.
docs/*.mpeg
docs/*.ogg
docs/*.m4a
docs/*.mp3
docs/WhatsApp*

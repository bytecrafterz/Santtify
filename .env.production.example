# Modelo do ambiente de PRODUÇÃO.
#
#   cp .env.production.example .env.production
#
# Depois preencha os segredos. NUNCA versione o .env.production preenchido.
# Gere cada segredo com:  openssl rand -base64 48

# ── Domínio ────────────────────────────────────────────────────────
# Sem https:// e sem barra final. O DNS (A/AAAA) precisa já apontar para o
# servidor ANTES de subir, senão o Caddy não consegue emitir o certificado.
#
# ATENÇÃO: este domínio fica gravado DENTRO de cada QR Code gerado. Trocar
# depois de imprimir material invalida os QR impressos. Decida antes.
DOMINIO=alfabetosaudavel.com

# ── Banco ──────────────────────────────────────────────────────────
POSTGRES_USER=pv
POSTGRES_PASSWORD=
POSTGRES_DB=produto_vivo

# ── Autenticação ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Privacidade (LGPD/GDPR) ────────────────────────────────────────
# Salt do hash de IP e user-agent. Trocar este valor depois do lançamento
# quebra a correlação com tudo que já foi gravado — defina uma vez e guarde.
PRIVACY_HASH_SALT=
EVENT_RETENTION_DAYS=1095
# Subir esta versão faz o banner de consentimento voltar a aparecer para
# todo mundo. É o comportamento correto quando a política muda de verdade.
CONSENT_POLICY_VERSION=1.0.0

# ── PWA ────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROJETO_PADRAO=jesus-alfabeto-saudavel
# Número do WhatsApp do botão da página Produto Vivo, só dígitos com país.
NEXT_PUBLIC_WHATSAPP_PV=

# ── Backup ─────────────────────────────────────────────────────────
BACKUP_RETENCAO_DIAS=14

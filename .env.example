# ── Banco ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pv:pv_dev_password@localhost:5433/produto_vivo?schema=public"
POSTGRES_USER=pv
POSTGRES_PASSWORD=pv_dev_password
POSTGRES_DB=produto_vivo
POSTGRES_PORT=5433

# ── API ────────────────────────────────────────────────────────────
API_PORT=3333
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=troque-em-producao-access
JWT_REFRESH_SECRET=troque-em-producao-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Privacidade (LGPD/GDPR) ────────────────────────────────────────
# Salt do servidor para hash de IP e user-agent. NUNCA versionar o valor real.
# Trocar este salt invalida a correlação de hashes anteriores — é intencional.
PRIVACY_HASH_SALT=troque-em-producao-salt
# Política de retenção de eventos brutos, em dias.
EVENT_RETENTION_DAYS=1095
CONSENT_POLICY_VERSION=1.0.0

# ── URLs públicas ──────────────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333/api
# URL publica da propria API — usada para montar o endereco dos arquivos
# enviados pelo painel. Em producao, o dominio real da API.
PUBLIC_API_URL=http://localhost:3333

# ── Midia enviada pelo painel ──────────────────────────────────────
# Disco local. PRECISA ser volume persistente com backup: recriar o
# container sem volume apaga todas as musicas e audios do cliente.
UPLOAD_DIR=./uploads

# Base dos links curtos e QR Codes — o valor fica CODIFICADO dentro de cada QR
# gerado, então mudá-lo depois invalida os QR já impressos. Definir antes do
# lançamento e não mexer.
#
# A rota /r/:code é servida pela API. Em produção, o proxy reverso encaminha
# https://dominio.com/r/* para a API, e o link curto usa o domínio principal:
# encurta o QR (leitura melhor) e evita um domínio estranho no WhatsApp.
# Em desenvolvimento, sem proxy, aponta direto para a API.
PUBLIC_SHORTLINK_BASE=http://localhost:3333/r

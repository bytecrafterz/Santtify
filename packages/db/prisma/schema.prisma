// Produto Vivo — modelo de dados
//
// Regra 1: nada aqui conhece o conceito de "letra" ou "alfabeto".
//          Uma letra é um Content de um Project. Só isso.
// Regra 2: Event é fonte da verdade e append-only.
//          DailyMetric e ContentStats são derivados e sempre recalculáveis.
//
// Ver docs/ARQUITETURA.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// PROJETOS
// ═══════════════════════════════════════════════════════════════════

/// Um projeto = uma vitrine dentro do Produto Vivo.
/// "Jesus Alfabeto Saudável" é o projeto nº 1. O painel multi-projeto é
/// Fase 2, mas o modelo já é multi-projeto desde a primeira migration.
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  /// Identidade visual — cada empresa mantém a sua no white label.
  branding Json @default("{}")

  /// Marco de lançamento deste projeto (o "Dia Zero").
  launchedAt DateTime?

  /// Link externo de compra (Hotmart ou equivalente).
  ///
  /// É do PROJETO e não de cada letra: o produto é um só, então o cliente cola
  /// uma vez e o botão aparece nas 26. Guardar por letra seria 26 lugares para
  /// ele errar e depois manter.
  checkoutUrl String?

  /// A capa do projeto no carrossel do perfil.
  coverUrl String?

  /// A frase curta debaixo do nome, no cartão do carrossel.
  tagline String?

  /// Qual das duas casas de destaque este projeto ocupa, ou nenhuma.
  ///
  /// `@unique` num campo opcional faz exactamente o que o cliente pediu no
  /// ponto 1: o Postgres deixa passar tantos nulos quantos quiser, mas só um
  /// ESQUERDA e um DIREITA. Pôr um projeto em destaque tira de lá o que
  /// estava, e o que sai continua no carrossel — não é preciso código nenhum
  /// a vigiar isso, a base não deixa haver dois.
  destaque DestaqueDoCarrossel? @unique

  /// A ordem no carrossel, depois dos dois destaques.
  ordemNoCarrossel Int @default(0)

  /// Foto publicada por usuário espera aprovação antes de ficar visível.
  ///
  /// É uma chave, e não uma decisão gravada no código, porque o dono da
  /// plataforma é quem paga o custo dos dois lados: ligada, alguém precisa
  /// olhar cada foto; desligada, a foto fica pública no instante do envio.
  /// Quem responde pelo conteúdo hospedado tem de poder decidir isso sem
  /// depender de mim, e mudar de ideia depois sem refazer nada.
  photoApprovalRequired Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents   Content[]
  campaigns  Campaign[]
  shortLink  ShortLink[]
  visitors   Visitor[]
  sessions   VisitSession[]
  events     Event[]
  metrics    DailyMetric[]
  baselines  BaselineSnapshot[]
  comments   Comment[]
  reactions  Reaction[]
  auditLogs  AdminAuditLog[]
  launches   Launch[]
  posts      Post[]
  categories BlockCategory[]
  reports    Report[]

  /// Perfil que hospeda a experiência: é o que toda a gente vê no topo.
  ///
  /// O projeto tem um rosto, e é sempre o mesmo para quem chega. Mostrar a
  /// cada visitante o seu próprio perfil vazio faz da porta de entrada um
  /// formulário; mostrar o do dono faz dela uma pessoa.
  hostUserId     String?         @db.Uuid
  host           User?           @relation("PerfilAnfitriao", fields: [hostUserId], references: [id], onDelete: SetNull)
  passwordResets PasswordReset[]

  modelosDeCartao  ModeloDeCartao[]
  precoDeCartoes   PrecoDeCartoes?
  pedidosDeCartoes PedidoDeCartoes[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ═══════════════════════════════════════════════════════════════════
// CONTEÚDO
// ═══════════════════════════════════════════════════════════════════

/// Unidade genérica de conteúdo. No alfabeto, cada letra é um Content.
/// Num próximo projeto, pode ser um produto, um vídeo, um episódio.
model Content {
  id String @id @default(uuid()) @db.Uuid

  /// A LETRA a que este conteúdo pertence: "A", "B"... ou nulo.
  ///
  /// A grade era montada pela posição na lista, e bastou o cliente criar uma
  /// Introdução para tudo escorregar uma casa: a introdução passou a ocupar o
  /// lugar do A, e o A o lugar do B. Posição é ordem de exibição, não
  /// identidade — e a ordem muda sempre que alguém publica.
  ///
  /// Nulo de propósito para o que não é letra: a introdução do projeto existe,
  /// aparece, e não conta para as 26.
  letra String? @db.Char(1)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  subtitle  String?
  summary   String?
  coverUrl  String?

  /// Material gratuito para download nesta letra (o PDF do cartão).
  ///
  /// Fica no conteúdo e não numa lista fixa: o cliente quer a demonstração
  /// grátis só na letra A por enquanto, e o botão aparece apenas onde existe
  /// arquivo. Liberar outra letra depois é subir o PDF dela, sem tocar no código.
  freeFileUrl  String?
  freeFileName String?

  /// Cartão 1200x630 da capa, para a prévia do link nas redes.
  ///
  /// Gravado junto com a capa, e não deduzido dela na hora de montar a página:
  /// o robô do WhatsApp busca a prévia com pressa, e uma consulta a mais no
  /// meio disso é a diferença entre o cartão aparecer e o link sair pelado.
  shareCardUrl String?
  status       ContentStatus @default(DRAFT)
  /// Ordem de exibição dentro do projeto (A=1, B=2, ... no alfabeto).
  position     Int           @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blocks    ContentBlock[]
  metadata  ContentMetadata?
  stats     ContentStats?
  shortLink ShortLink[]
  reactions Reaction[]
  comments  Comment[]
  events    Event[]
  posts     Post[]

  @@unique([projectId, slug])
  @@index([projectId, status, position])
  @@map("contents")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A página de um conteúdo é composta por blocos ordenados, não por campos
/// fixos. É isso que impede o formato "música + letra + texto educativo" do
/// alfabeto de virar o schema da plataforma inteira.
/// O papel de um cartão dentro da letra.
enum CardPapel {
  /// Imagem, áudio, interações, título e texto — a peça que se repete.
  CARTAO
  /// O cartão de impressão da letra: um por letra, opcional, sem cópias.
  IMPRESSAO
}

/// Um cartão só sai de rascunho quando está inteiro.
enum CardEstado {
  RASCUNHO
  PUBLICADO
}

model ContentBlock {
  id        String          @id @default(uuid()) @db.Uuid
  /// Engajamento próprio da faixa (decisão de 19/08).
  reactions BlockReaction[]
  comments  Comment[]
  contentId String          @db.Uuid
  content   Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  position  Int             @default(0)
  type      BlockType

  /// Categoria do áudio: Explicação, Música, Memorização, Oração...
  ///
  /// É uma tabela e não um enum de propósito: o cliente pediu para poder criar
  /// categorias novas sozinho, pelo painel, sem esperar por mim. Enum exigiria
  /// migration a cada ideia nova dele.
  categoryId String?        @db.Uuid
  category   BlockCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Rótulo livre definido pelo admin: "Letra da música", "Conteúdo educativo".
  label      String?
  /// Corpo textual, para TEXT e RICH_TEXT.
  text       String?
  assetId    String?        @db.Uuid
  asset      MediaAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Arte própria desta faixa.
  ///
  /// O cliente manda uma imagem por ÁUDIO, e não uma por letra: a música tem o
  /// palco, a memorização tem o versículo, a oração tem a cena da oração. A
  /// capa da letra (`Content.coverUrl`) continua existindo e é outra coisa —
  /// é ela que vai na prévia do link quando alguém compartilha.
  imageAssetId String?     @db.Uuid
  imageAsset   MediaAsset? @relation("BlockImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  /// URL externa, para EMBED e LINK.
  url          String?
  meta         Json        @default("{}")

  // ── O CARTÃO COMO PEÇA ÚNICA (23/08) ──────────────────────────────────
  //
  // O cliente passou quatro dias a ver a fotografia aparecer separada do
  // áudio, e a diagnosticar bem: encostá-los por CSS melhora a aparência e não
  // os torna a mesma coisa. Enquanto a imagem, o som, o título e o texto forem
  // peças que por acaso estão juntas, há sempre um caminho no código que as
  // separa outra vez.
  //
  // A partir daqui um CARTÃO é uma linha só, com tudo dentro: `imageAssetId` é
  // a imagem, `assetId` é o áudio, `titulo` é o título grande, `text` é a
  // descrição. As curtidas, os comentários e as escutas já eram dele. Não há
  // como publicar meio cartão porque não há meio cartão — há um rascunho.

  /// A casa deste cartão dentro da letra: 1 a 4, na ordem que ele fixou —
  /// explicação, música, repetição do versículo, oração. As cópias feitas com
  /// "Duplicar" não têm casa: vivem a seguir à original de onde saíram.
  slot Int?

  /// O papel do cartão. Um cartão comum, ou o cartão de impressão da letra —
  /// que é único, opcional, e nasce do quarto quadrado.
  papel CardPapel @default(CARTAO)

  /// Rascunho enquanto faltar imagem, áudio, título ou descrição. Publicado só
  /// quando estiver inteiro. É esta coluna que impede meia publicação de
  /// chegar à página, e é a razão de tudo isto existir.
  estado CardEstado @default(RASCUNHO)

  /// O título GRANDE que a pessoa lê na página.
  ///
  /// Separado de `label` de propósito: `label` guarda o nome interno do
  /// quadrado ("Música", "Oração"), que serve para o cliente se orientar no
  /// painel e que ele foi explícito a dizer que NÃO aparece na página.
  titulo String?

  /// Link de venda desta letra — Hotmart, Kiwify ou outra. Alimenta o botão
  /// "Fazer upgrade". Fica no cartão e não no projeto porque ele quer poder
  /// vender coisas diferentes em letras diferentes.
  linkUpgrade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId, position])
  @@index([contentId, slot])
  @@index([categoryId])
  @@index([imageAssetId])
  @@map("content_blocks")
}

/**
 * Categoria de áudio dentro de um projeto.
 * Existe para a playlist poder ser filtrada — "só músicas", "só orações" — e
 * para o cliente criar categorias novas sem tocar no código.
 * `onDelete: SetNull` no bloco: apagar uma categoria não pode apagar o áudio
 * que estava nela. O áudio volta a ser "sem categoria" e continua tocando.
 */
model BlockCategory {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Nome como aparece na tela: "Música", "Memorização do versículo".
  name     String
  /// Identificador estável na URL do filtro: "musica", "memorizacao".
  slug     String
  /// Ordem dos filtros na playlist.
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks ContentBlock[]

  @@unique([projectId, slug])
  @@index([projectId, position])
  @@map("block_categories")
}

enum BlockType {
  TEXT
  RICH_TEXT
  AUDIO
  VIDEO
  IMAGE
  EMBED
  LINK
}

/// Arquivo enviado pelo admin. Reutilizável entre blocos e projetos.
model MediaAsset {
  id         String    @id @default(uuid()) @db.Uuid
  kind       MediaKind
  url        String
  mimeType   String?
  sizeBytes  Int?
  durationMs Int?
  title      String?
  altText    String?

  /// Dimensões da versão servida no site (só imagem).
  width  Int?
  height Int?

  /// Cartão 1200x630 usado na prévia do link no WhatsApp e nas redes.
  ///
  /// Fica guardado porque a arte das letras é retrato A4: o recorte que essas
  /// plataformas fazem numa imagem alta cortaria a marca no topo e o selo
  /// embaixo, que é justamente o que o cliente quer que apareça.
  shareCardUrl String?

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  blocks      ContentBlock[]
  blockImages ContentBlock[] @relation("BlockImage")
  posts       Post[]         @relation("PostImage")

  @@map("media_assets")
}

enum MediaKind {
  AUDIO
  VIDEO
  IMAGE
  DOCUMENT
}

/// Metadados analíticos do conteúdo — pedido explícito do cliente para que a IA
/// da Fase 2 possa cruzar DESEMPENHO x CARACTERÍSTICAS.
/// Tabela separada de propósito: é dado analítico, não de renderização, e não
/// deve pesar no caminho quente de leitura da página.
model ContentMetadata {
  contentId String  @id @db.Uuid
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// Plataforma de destino/origem pretendida do conteúdo.
  platform    Platform?
  /// Formato: reel, short, carrossel, post, página...
  format      String?
  /// Tema/assunto, para agrupamento analítico.
  theme       String?
  /// Referência do produto associado (checkout externo).
  productRef  String?
  campaignId  String?   @db.Uuid
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// Call to action usado.
  cta         String?
  /// Variante de teste A/B.
  testVariant String?
  /// Data/hora planejada ou de publicação do conteúdo na origem.
  scheduledAt DateTime?

  /// Qualquer característica futura, sem migration.
  attributes Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([theme])
  @@index([testVariant])
  @@map("content_metadata")
}

// ═══════════════════════════════════════════════════════════════════
// CAMPANHAS
// ═══════════════════════════════════════════════════════════════════

/// Identificador próprio por campanha / publicação / vídeo.
/// É o que permite ler "Instagram → Vídeo 03 → 850 visitas → 120 cadastros".
model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Código curto usado na URL (?pv=<code>).
  code        String    @unique
  platform    Platform
  name        String
  /// Formato da publicação: reel, short, story, post, vídeo longo...
  format      String?
  theme       String?
  cta         String?
  testVariant String?
  /// Link do post/vídeo original, para conferência humana.
  externalUrl String?
  publishedAt DateTime?

  attributes Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shortLinks       ShortLink[]
  events           Event[]
  visitorsFirst    Visitor[]         @relation("VisitorFirstTouchCampaign")
  visitorsLast     Visitor[]         @relation("VisitorLastTouchCampaign")
  visitorsRoot     Visitor[]         @relation("VisitorRootCampaign")
  contentMetadatas ContentMetadata[]
  sessions         VisitSession[]

  @@index([projectId, platform])
  @@map("campaigns")
}

/// Origens rastreadas. PRODUTO_VIVO = propagação interna (compartilhamento
/// feito por alguém que já estava dentro da plataforma).
enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  WHATSAPP
  GOOGLE
  DIRECT
  QR_CODE
  PRODUTO_VIVO
  EMAIL
  OTHER
}

// ═══════════════════════════════════════════════════════════════════
// LINKS RASTREÁVEIS E QR CODES
// ═══════════════════════════════════════════════════════════════════

/// Espinha dorsal do rastreamento. Todo link rastreável passa por aqui:
/// o QR de um conteúdo, o link de uma campanha e o link gerado quando um
/// usuário compartilha.
///
/// parentShortLinkId é a ARESTA da cadeia de propagação.
/// rootShortLinkId e depth são desnormalizados no momento da criação para que
/// "quanto esta cadeia inteira gerou" seja uma consulta, não uma reconstrução.
model ShortLink {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Código curto único, usado na URL pública e codificado no QR.
  code      String        @unique
  kind      ShortLinkKind

  contentId String?  @db.Uuid
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  /// Preenchido quando kind = SHARE: quem compartilhou.
  createdByUserId String? @db.Uuid
  createdByUser   User?   @relation("UserShareLinks", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Canal do compartilhamento (WhatsApp, Instagram, cópia de link...).
  channel Platform?

  /// Cadeia de propagação.
  parentShortLinkId String?     @db.Uuid
  parentShortLink   ShortLink?  @relation("ShortLinkChain", fields: [parentShortLinkId], references: [id], onDelete: Restrict)
  children          ShortLink[] @relation("ShortLinkChain")

  /// Raiz da cadeia, desnormalizada. Aponta para si mesmo quando depth = 0.
  rootShortLinkId String?     @db.Uuid
  rootShortLink   ShortLink?  @relation("ShortLinkRoot", fields: [rootShortLinkId], references: [id], onDelete: Restrict)
  descendants     ShortLink[] @relation("ShortLinkRoot")

  /// 0 = link de origem (campanha ou QR). 1+ = veio de compartilhamento.
  depth Int @default(0)

  /// Plataforma que originou a cadeia inteira (o Instagram do exemplo).
  rootPlatform Platform?

  /// URL de destino resolvida.
  targetUrl String

  /// QR gerado no momento da publicação. Nulo para links de compartilhamento.
  qrSvg String?

  clickCount Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           Event[]
  eventsAsParent   Event[]        @relation("EventParentShortLink")
  eventsAsRoot     Event[]        @relation("EventRootShortLink")
  visitorsFirst    Visitor[]      @relation("VisitorFirstTouchLink")
  visitorsLast     Visitor[]      @relation("VisitorLastTouchLink")
  visitorsAcquired Visitor[]      @relation("VisitorAcquiredVia")
  visitorsRoot     Visitor[]      @relation("VisitorRootLink")
  sessions         VisitSession[]
  shares           Share[]

  @@index([projectId, kind])
  @@index([rootShortLinkId])
  @@index([parentShortLinkId])
  @@index([createdByUserId])
  @@index([contentId])
  @@map("short_links")
}

enum ShortLinkKind {
  /// QR Code de um conteúdo, gerado automaticamente na publicação.
  CONTENT_QR
  /// Link de uma campanha/post/vídeo.
  CAMPAIGN
  /// Link gerado quando um usuário compartilha.
  SHARE
  CUSTOM
}

/// Vitrine de próximos produtos — a área "Meus Lançamentos" do perfil.
///
/// Definida pelos mockups do cliente: NÃO são lançamentos do usuário, e sim os
/// próximos produtos que ele está preparando, com o status de cada um. A lista
/// é a mesma para todo mundo, apesar de aparecer dentro do perfil.
///
/// Fica ligada ao Project e não ao alfabeto: o próximo projeto tem a própria
/// vitrine sem código novo.
model Launch {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  status      LaunchStatus @default(EM_BREVE)
  /// Ordem de exibição na vitrine.
  position    Int          @default(0)
  /// Link externo opcional, para quando o produto sair.
  externalUrl String?
  visible     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, visible, position])
  @@map("launches")
}

enum LaunchStatus {
  EM_BREVE
  EM_DESENVOLVIMENTO
  LANCADO
}

// ═══════════════════════════════════════════════════════════════════
// IDENTIDADE
// ═══════════════════════════════════════════════════════════════════

/// Visitante pseudônimo. Existe desde o PRIMEIRO acesso, antes de qualquer
/// cadastro. É o que preserva a atribuição de quem chegou pelo Instagram e só
/// se cadastrou três dias depois.
model Visitor {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Identificador anônimo persistido no dispositivo.
  anonId    String  @unique

  /// Ligado no cadastro. A atribuição anterior é preservada.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // ── Origem 1: como ESTA pessoa chegou pela primeira vez ────────────
  firstTouchPlatform   Platform?
  firstTouchSource     String?
  firstTouchMedium     String?
  firstTouchCampaignId String?    @db.Uuid
  firstTouchCampaign   Campaign?  @relation("VisitorFirstTouchCampaign", fields: [firstTouchCampaignId], references: [id], onDelete: Restrict)
  firstTouchLinkId     String?    @db.Uuid
  firstTouchLink       ShortLink? @relation("VisitorFirstTouchLink", fields: [firstTouchLinkId], references: [id], onDelete: Restrict)
  firstTouchAt         DateTime?

  // ── Origem 2: de onde veio a visita mais recente ───────────────────
  lastTouchPlatform   Platform?
  lastTouchSource     String?
  lastTouchMedium     String?
  lastTouchCampaignId String?    @db.Uuid
  lastTouchCampaign   Campaign?  @relation("VisitorLastTouchCampaign", fields: [lastTouchCampaignId], references: [id], onDelete: Restrict)
  lastTouchLinkId     String?    @db.Uuid
  lastTouchLink       ShortLink? @relation("VisitorLastTouchLink", fields: [lastTouchLinkId], references: [id], onDelete: Restrict)
  lastTouchAt         DateTime?

  // ── Origem 3: o que originou a CADEIA inteira ──────────────────────
  rootPlatform   Platform?
  rootCampaignId String?    @db.Uuid
  rootCampaign   Campaign?  @relation("VisitorRootCampaign", fields: [rootCampaignId], references: [id], onDelete: Restrict)
  rootLinkId     String?    @db.Uuid
  rootLink       ShortLink? @relation("VisitorRootLink", fields: [rootLinkId], references: [id], onDelete: Restrict)
  /// Primeira pessoa da cadeia (o "Usuário A" do exemplo do cliente).
  rootVisitorId  String?    @db.Uuid

  // ── Cadeia de propagação ───────────────────────────────────────────
  /// Link pelo qual esta pessoa foi adquirida.
  acquiredViaLinkId String?    @db.Uuid
  acquiredViaLink   ShortLink? @relation("VisitorAcquiredVia", fields: [acquiredViaLinkId], references: [id], onDelete: Restrict)
  /// Quem compartilhou o link que trouxe esta pessoa.
  referredByUserId  String?    @db.Uuid
  referredByUser    User?      @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: Restrict)
  /// 0 = veio direto de uma plataforma. 1+ = trazido por propagação interna.
  chainDepth        Int        @default(0)

  // ── LGPD / GDPR: nada de dado pessoal cru ──────────────────────────
  consentStatus ConsentStatus @default(PENDING)
  consentAt     DateTime?
  ipHash        String?
  userAgentHash String?
  deviceType    String?
  countryCode   String?       @db.VarChar(2)
  /// Região e cidade APROXIMADAS, resolvidas na base offline.
  ///
  /// Nomes e nunca coordenadas: a base devolve latitude e longitude e nada
  /// disso é guardado. Num telemóvel isto é onde está o equipamento da
  /// operadora, e não onde está a pessoa; o painel diz isso ao lado do número.
  regionName    String?       @db.VarChar(80)
  cityName      String?       @db.VarChar(80)

  /**
   * Esta visita não entra nas métricas.
   * Em 27/08 o painel mostrava 66 acessos da Alemanha a um projeto nunca
   * divulgado lá. Eram todos da máquina de desenvolvimento, que fica num centro
   * de dados alemão. Ele ia decidir em que idioma traduzir a plataforma a partir
   * daquele número.
   * Marca-se em vez de apagar: os eventos são append-only e apagar o visitante
   * levava-os atrás. Quem for administrador do projeto entra aqui à partida, que
   * foi o pedido dele: entra dezenas de vezes por dia a testar e não quer
   * contaminar os dados de quem chega de fora.
   */
  ignoradoNasMetricas Boolean @default(false)

  sessions VisitSession[]
  events   Event[]
  consents Consent[]

  @@index([projectId, firstSeenAt])
  @@index([projectId, ignoradoNasMetricas])
  /// Serve a análise por país e região do painel: filtra por `countryCode` e
  /// agrupa por `regionName` dentro de um projeto. Existia na base desde a
  /// migração 20260828100000 e faltava aqui — declarado agora para o índice
  /// não se perder na primeira migração que alguém gerar.
  @@index([projectId, countryCode, regionName])
  @@index([projectId, chainDepth])
  @@index([referredByUserId])
  @@index([rootVisitorId])
  @@index([rootCampaignId])
  @@index([userId])
  @@map("visitors")
}

enum ConsentStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

/// Perfil global, NÃO por projeto — o cliente foi explícito: um só perfil,
/// interagindo com várias empresas.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  /// O @identificador, único e sempre em minúsculas.
  ///
  /// Opcional na base e obrigatório no cadastro, e a diferença é deliberada:
  /// as contas criadas antes desta regra não podem ser trancadas fora por
  /// causa dela. Ver a migração 20260901090000.
  username     String?  @unique @db.VarChar(20)
  avatarUrl    String?
  bio          String?
  /// Quem acompanha um perfil infantil, mostrado junto ao nome.
  ///
  /// Campo próprio e não dentro da bio: numa plataforma usada por crianças,
  /// dizer publicamente que existe um adulto responsável é informação de
  /// segurança, e informação de segurança não pode depender de a pessoa se
  /// lembrar de escrevê-la no meio de um texto livre.
  guardianName String?
  role         UserRole @default(USER)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  status          UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitors           Visitor[]
  referredUsers      Visitor[]       @relation("UserReferrals")
  shareLinks         ShortLink[]     @relation("UserShareLinks")
  reactions          Reaction[]
  blockReactions     BlockReaction[]
  comments           Comment[]
  denuncias          Report[]        @relation("DenunciasFeitas")
  bloqueiosFeitos    UserBlock[]     @relation("BloqueiosFeitos")
  bloqueiosRecebidos UserBlock[]     @relation("BloqueiosRecebidos")
  shares             Share[]
  events             Event[]
  sessions           VisitSession[]
  consents           Consent[]
  uploads            MediaAsset[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  auditLogs          AdminAuditLog[]
  posts              Post[]

  projetosAnfitriao     Project[]         @relation("PerfilAnfitriao")
  comentariosNoPerfil   Comment[]         @relation("ComentariosNoPerfil")
  curtidasNoPerfil      ProfileReaction[] @relation("CurtidasNoPerfil")
  curtidasQueFiz        ProfileReaction[] @relation("CurtidasQueFiz")
  curtidasEmComentarios CommentReaction[] @relation("CurtidasEmComentarios")
  pedidosDeCartoes      PedidoDeCartoes[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/**
 * Um pedido de reposição de senha.
 * Existe porque a irmã do cliente ficou sem entrar em 23/08 e ele só soube
 * porque ela lhe telefonou. A observação dele é a certa e é o motivo desta
 * tabela: se acontecesse a cem desconhecidos, ninguém saberia — pareceria
 * desinteresse, e era avaria.
 * A LINHA É CRIADA MESMO QUANDO O E-MAIL NÃO EXISTE, com `userId` nulo. Duas
 * razões. À pessoa responde-se sempre o mesmo, para o formulário não servir
 * para descobrir quem tem conta. E ao responsável interessa saber que alguém
 * tentou entrar com um endereço que não existe: ou escreveu mal, ou pensa que
 * se registou e não se registou — e as duas coisas perdem-se em silêncio.
 * O token só nasce quando o responsável atende o pedido, e é guardado em
 * resumo (hash). Quem tiver acesso à base de dados não consegue entrar na
 * conta de ninguém com o que está aqui.
 */
model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  /// Nulo quando o endereço pedido não corresponde a nenhuma conta.
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?   @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// O endereço tal como foi escrito, para o responsável reconhecer a pessoa.
  emailPedido String
  /// Resumo do token. Nulo enquanto o pedido não for atendido.
  tokenHash   String?
  expiresAt   DateTime?
  usedAt      DateTime?
  atendidoEm  DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("password_resets")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  /**
   * Quando este token foi TROCADO por outro — que é diferente de ter sido
   * revogado.
   * Um token trocado continua a valer durante um minuto, e é isso que salva a
   * sessão de quem tem rede má. O cliente relatou em 24/08 que ficava três
   * horas sem entrar e ao voltar tinha de fazer login outra vez: o telemóvel
   * acorda, pede a troca, o servidor troca e revoga o antigo, e a resposta
   * perde-se pelo caminho. O telefone fica com um token que o servidor já
   * matou, e a sessão morre sem ninguém ter feito nada de errado.
   * Sair da conta continua a valer imediatamente, e é por isso que são duas
   * colunas e não uma: `revokedAt` sem `rotatedAt` é uma porta fechada à chave.
   */
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Sessão de visita. Base para tempo médio de permanência (apresentado na
/// Fase 2, coletado desde já).
model VisitSession {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitorId String  @db.Uuid
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  startedAt   DateTime  @default(now())
  lastEventAt DateTime  @default(now())
  endedAt     DateTime?
  durationMs  Int?
  pageViews   Int       @default(0)

  /// Atribuição de entrada desta sessão específica (origem imediata).
  entryPlatform   Platform?
  entryCampaignId String?    @db.Uuid
  entryCampaign   Campaign?  @relation(fields: [entryCampaignId], references: [id], onDelete: Restrict)
  entryLinkId     String?    @db.Uuid
  entryLink       ShortLink? @relation(fields: [entryLinkId], references: [id], onDelete: Restrict)
  landingPath     String?

  events Event[]

  @@index([projectId, startedAt])
  @@index([visitorId, startedAt])
  @@map("visit_sessions")
}

// ═══════════════════════════════════════════════════════════════════
// EVENTOS — FONTE DA VERDADE, APPEND-ONLY
// ═══════════════════════════════════════════════════════════════════

/// A tabela que não pode ser refeita depois.
///
/// Cada linha carrega um SNAPSHOT da atribuição no momento em que o evento
/// ocorreu — não uma referência ao estado atual do visitante. Se a atribuição
/// do visitante mudar amanhã, o que aconteceu ontem continua verdadeiro.
///
/// Nunca sofre UPDATE. Nunca sofre DELETE fora da política de retenção.
model Event {
  id         BigInt   @id @default(autoincrement())
  /// Quando aconteceu (relógio do cliente, corrigido no servidor).
  occurredAt DateTime @default(now())
  /// Quando o servidor recebeu. Divergência revela atraso ou manipulação.
  receivedAt DateTime @default(now())

  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      EventType

  // Restrict, e não SetNull, em tudo o que carrega atribuição.
  // Apagar um usuário, conteúdo ou campanha NÃO pode zerar o histórico dos
  // eventos — seria destruir em silêncio exatamente o dado que o cliente
  // contratou. Para o direito ao apagamento da LGPD/GDPR, anonimiza-se o
  // registro do usuário e preserva-se o id; ver docs/ARQUITETURA.md.
  visitorId String        @db.Uuid
  visitor   Visitor       @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  userId    String?       @db.Uuid
  user      User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String?       @db.Uuid
  session   VisitSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  contentId String?  @db.Uuid
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Restrict)

  // ── Snapshot de atribuição no momento do evento ────────────────────
  platform    Platform?
  source      String?
  medium      String?
  campaignId  String?   @db.Uuid
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// Referência externa da publicação (id do post, do vídeo).
  campaignRef String?

  /// referral_id — o link pelo qual esta pessoa chegou.
  shortLinkId       String?    @db.Uuid
  shortLink         ShortLink? @relation(fields: [shortLinkId], references: [id], onDelete: Restrict)
  /// parent_referral — o elo anterior da cadeia.
  parentShortLinkId String?    @db.Uuid
  parentShortLink   ShortLink? @relation("EventParentShortLink", fields: [parentShortLinkId], references: [id], onDelete: Restrict)
  /// Raiz da cadeia. Permite somar o valor gerado por uma cadeia inteira.
  rootShortLinkId   String?    @db.Uuid
  rootShortLink     ShortLink? @relation("EventRootShortLink", fields: [rootShortLinkId], references: [id], onDelete: Restrict)
  rootPlatform      Platform?
  chainDepth        Int        @default(0)

  // ── Comércio: RESERVADO. Nenhum evento destes é gerado na Fase 1. ──
  // A integração do checkout externo (Fase 2) liga a entrada e não toca
  // no schema.
  productRef       String?
  value            Decimal? @db.Decimal(14, 2)
  currency         String?  @db.VarChar(3)
  externalOrderRef String?

  // ── Extensibilidade sem migration ──────────────────────────────────
  props Json @default("{}")

  // ── Contexto técnico, sem dado pessoal cru ─────────────────────────
  path          String?
  referrerHost  String?
  ipHash        String?
  userAgentHash String?
  deviceType    String?
  countryCode   String? @db.VarChar(2)

  @@index([projectId, occurredAt])
  @@index([projectId, type, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([userId, occurredAt])
  @@index([contentId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([shortLinkId])
  @@index([rootShortLinkId])
  @@index([platform, occurredAt])
  @@index([sessionId])
  @@map("events")
}

enum EventType {
  SESSION_START
  PAGE_VIEW
  CONTENT_VIEW
  QR_SCAN

  CONSENT_GIVEN
  CONSENT_REVOKED

  SIGNUP
  LOGIN
  LOGOUT

  MEDIA_PLAY
  MEDIA_PROGRESS
  MEDIA_COMPLETE

  LIKE
  UNLIKE
  COMMENT
  COMMENT_DELETED

  SHARE_CREATED
  SHARE_LINK_CLICKED

  POST_CREATED
  POST_DELETED

  PROFILE_VIEW

  /// Clique no botão que leva ao grupo do Produto Vivo.
  ///
  /// Separado do PV_CLICK de propósito: abrir a página é curiosidade, pedir
  /// para entrar no grupo é intenção. É a diferença entre "quantos olharam" e
  /// "quantas empresas quero contar para o investidor".
  PV_CONTACT

  /// Clique no selo PV, em qualquer letra.
  ///
  /// Tipo próprio e não CUSTOM porque esta é a métrica comercial do Produto
  /// Vivo: a contagem é GLOBAL, somando os cliques de todas as letras, e
  /// precisa ser consultável sem depender de filtrar por um campo JSON.
  PV_CLICK

  /// Reservados para a Fase 2 (checkout externo).
  CHECKOUT_CLICKED
  PURCHASE_COMPLETED
  PURCHASE_REFUNDED

  CUSTOM
}

// ═══════════════════════════════════════════════════════════════════
// SOCIAL — genérico sobre Content, futuro white label
// ═══════════════════════════════════════════════════════════════════

model Reaction {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentId String       @db.Uuid
  content   Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([contentId, userId, type])
  @@index([contentId])
  @@index([userId])
  @@map("reactions")
}

enum ReactionType {
  LIKE
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Nulo quando o comentário é de um perfil e não de uma letra.
  contentId String?  @db.Uuid
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Perfil comentado. Mesma tabela dos outros comentários, e não uma à parte,
  /// pela mesma razão de sempre: a fila de moderação dele lê daqui, e o que
  /// ficasse fora dela seria publicado sem ninguém ver.
  profileUserId String? @db.Uuid
  profileUser   User?   @relation("ComentariosNoPerfil", fields: [profileUserId], references: [id], onDelete: Cascade)

  /// Faixa comentada, quando o comentário é de um áudio e não da letra inteira.
  ///
  /// Coluna nova na MESMA tabela, e não uma tabela à parte, porque a moderação
  /// do cliente lê daqui. Separar em duas tabelas obrigaria a fila dele a
  /// juntar duas origens, e o comentário que escapasse a essa junção ficaria
  /// publicado sem ninguém o ver.
  blockId String?       @db.Uuid
  block   ContentBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  /// Respostas a comentários.
  parentId  String?           @db.Uuid
  parent    Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentThread")
  reactions CommentReaction[]

  body     String
  status   CommentStatus @default(PUBLISHED)
  /// Quando foi editado. A tela mostra "editado" para o leitor saber que o
  /// texto mudou depois de alguém já lhe ter respondido.
  editedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([contentId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

/// Curtida de uma FAIXA (bloco), separada da curtida da letra inteira.
///
/// Tabela própria em vez de uma coluna opcional em Reaction: aquela tabela tem
/// uma unicidade em (conteúdo, pessoa, tipo) que impede a mesma pessoa de
/// curtir duas faixas da mesma letra. Mexer nessa unicidade num banco já com
/// dados é risco sem retorno — a curtida de faixa não precisa de moderação nem
/// de conviver com a da letra, então vive melhor ao lado.
model BlockReaction {
  id      String       @id @default(uuid()) @db.Uuid
  blockId String       @db.Uuid
  block   ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  userId  String       @db.Uuid
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([blockId, userId, type])
  @@index([blockId])
  @@map("block_reactions")
}

/// Motivos de denúncia, exactamente os seis que o cliente listou em 19/08.
enum ReportReason {
  IMPROPRIO
  SENSUAL
  BULLYING
  SPAM
  DADOS_PESSOAIS
  OUTRO
}

/// O que está a ser denunciado. Guardado como tipo + id em vez de uma relação
/// por cada alvo: denunciar é raro, e cinco colunas opcionais numa tabela
/// destas custam mais a ler do que o par tipo/id.
enum ReportTarget {
  CONTENT
  BLOCK
  COMMENT
  POST
  PROFILE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

/// Denúncia feita por uma pessoa, para o dono do projeto decidir.
///
/// O autor é opcional de propósito. Numa plataforma usada por crianças, exigir
/// conta para denunciar é pedir que a mãe se registe antes de avisar que há
/// algo errado — e nesse intervalo o conteúdo continua no ar. Denúncia sem
/// conta vale menos como prova, mas vale mais como aviso.
model Report {
  id         String  @id @default(uuid()) @db.Uuid
  projectId  String  @db.Uuid
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterId String? @db.Uuid
  reporter   User?   @relation("DenunciasFeitas", fields: [reporterId], references: [id], onDelete: SetNull)

  targetType ReportTarget
  targetId   String       @db.Uuid
  reason     ReportReason
  note       String?
  status     ReportStatus @default(PENDING)

  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?   @db.Uuid

  @@index([projectId, status, createdAt])
  @@map("reports")
}

/// Bloqueio entre pessoas: quem bloqueia deixa de ver o outro.
/// Curtida num PERFIL.
model ProfileReaction {
  id            String       @id @default(uuid()) @db.Uuid
  profileUserId String       @db.Uuid
  profileUser   User         @relation("CurtidasNoPerfil", fields: [profileUserId], references: [id], onDelete: Cascade)
  userId        String       @db.Uuid
  user          User         @relation("CurtidasQueFiz", fields: [userId], references: [id], onDelete: Cascade)
  type          ReactionType @default(LIKE)
  createdAt     DateTime     @default(now())

  @@unique([profileUserId, userId, type])
  @@index([profileUserId])
  @@map("profile_reactions")
}

/// Curtida num comentário.
///
/// Tabela própria pela mesma razão das outras curtidas deste projeto: a tabela
/// antiga tem unicidade por conteúdo, e um comentário não é um conteúdo.
model CommentReaction {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation("CurtidasEmComentarios", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_reactions")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blocker   User     @relation("BloqueiosFeitos", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("BloqueiosRecebidos", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("user_blocks")
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

/// Registro de um compartilhamento. O link gerado (ShortLink kind=SHARE) é o
/// que torna a propagação mensurável sem acessar conversas privadas.
model Share {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortLinkId String    @db.Uuid
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  channel     Platform
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([shortLinkId])
  @@map("shares")
}

/// Contadores quentes do conteúdo. DERIVADO de Event/Reaction/Comment.
/// Existe só para a página não agregar em tempo de leitura.
model ContentStats {
  contentId String  @id @db.Uuid
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  views          Int @default(0)
  uniqueVisitors Int @default(0)
  likes          Int @default(0)
  comments       Int @default(0)
  shares         Int @default(0)
  shareClicks    Int @default(0)
  qrScans        Int @default(0)

  recomputedAt DateTime @default(now())

  @@map("content_stats")
}

/// "My Post" — publicação feita pelo usuário no próprio perfil.
///
/// Escopo acordado com o cliente: a pessoa está ouvindo uma música ou áudio da
/// plataforma e publica AQUILO no perfil dela, com uma legenda escrita por ela.
/// Não é envio de arquivo do aparelho — foto e vídeo do usuário ficaram como
/// bloco separado, com moderação, justamente por serem outra engrenagem.
///
/// Por isso a publicação sempre aponta para um Content que já existe: o que a
/// pessoa acrescenta é a legenda e o ato de publicar, não o arquivo.
model Post {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// O conteúdo da plataforma que está sendo publicado.
  contentId String  @db.Uuid
  content   Content @relation(fields: [contentId], references: [id], onDelete: Restrict)

  /// Legenda escrita pela pessoa. Opcional: publicar sem texto é válido.
  body String?

  /// Foto enviada pela pessoa. Opcional — a publicação pode ser só o conteúdo
  /// da plataforma com legenda, que é como funcionava antes da foto entrar.
  imageAssetId String?     @db.Uuid
  imageAsset   MediaAsset? @relation("PostImage", fields: [imageAssetId], references: [id], onDelete: Restrict)

  /// Publicação com foto nasce PENDING e só aparece depois da aprovação.
  /// Sem foto, nasce PUBLISHED — legenda sobre música da plataforma não tem
  /// o mesmo risco que imagem de criança enviada do aparelho.
  status PostStatus @default(PUBLISHED)

  /// Quem moderou e quando, para a decisão ser auditável.
  moderatedAt    DateTime?
  moderatedById  String?   @db.Uuid
  moderationNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([contentId])
  @@index([imageAssetId])
  @@map("posts")
}

enum PostStatus {
  /// Aguardando aprovação. É o estado inicial de toda publicação com foto.
  PENDING
  PUBLISHED
  /// Recusada na moderação. A pessoa vê a recusa; o público não vê a foto.
  REJECTED
  HIDDEN
  DELETED
}

// ═══════════════════════════════════════════════════════════════════
// AGREGADOS — DERIVADOS, NUNCA FONTE DA VERDADE
// ═══════════════════════════════════════════════════════════════════

/// A "fotografia diária". Recalculável a partir de Event a qualquer momento.
/// Se divergir, recalcula-se. O inverso jamais acontece.
model DailyMetric {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Dia em UTC.
  date      DateTime @db.Date

  /// Dimensão do corte: TOTAL, PLATFORM, CAMPAIGN, CONTENT.
  dimension MetricDimension
  /// Chave da dimensão: null para TOTAL, 'INSTAGRAM', ou um uuid.
  dimKey    String?

  visitors       Int @default(0)
  uniqueVisitors Int @default(0)
  pageViews      Int @default(0)
  contentViews   Int @default(0)
  qrScans        Int @default(0)
  signups        Int @default(0)
  likes          Int @default(0)
  comments       Int @default(0)
  shares         Int @default(0)
  shareClicks    Int @default(0)

  /// Adquiridos por propagação interna do Produto Vivo.
  visitorsFromShares Int @default(0)
  signupsFromShares  Int @default(0)

  /// Reservado — Fase 2.
  checkoutClicks      Int     @default(0)
  purchases           Int     @default(0)
  purchasesFromShares Int     @default(0)
  revenue             Decimal @default(0) @db.Decimal(14, 2)

  computedAt DateTime @default(now())

  @@unique([projectId, date, dimension, dimKey])
  @@index([projectId, date])
  @@map("daily_metrics")
}

enum MetricDimension {
  TOTAL
  PLATFORM
  CAMPAIGN
  CONTENT
}

/// O "Dia Zero" e os marcos seguintes (Dia 7, 30, 60, 90...).
/// Registra a linha de base fora da plataforma — seguidores de cada rede no
/// lançamento — para a curva de crescimento ter um ponto de partida real.
model BaselineSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "Dia Zero", "Dia 7", "Dia 30"...
  label      String
  capturedAt DateTime
  platform   Platform
  /// Seguidores/inscritos na rede, ou usuários no caso do PRODUTO_VIVO.
  followers  Int?
  /// Métrica secundária livre (visualizações acumuladas, por exemplo).
  reach      Int?
  notes      String?
  attributes Json     @default("{}")

  createdAt DateTime @default(now())

  @@unique([projectId, label, platform])
  @@index([projectId, capturedAt])
  @@map("baseline_snapshots")
}

// ═══════════════════════════════════════════════════════════════════
// LGPD / GDPR
// ═══════════════════════════════════════════════════════════════════

/// Consentimento por visitante, com versão da política e finalidades
/// granulares. Cliente está em Portugal: GDPR é o piso.
model Consent {
  id        String  @id @default(uuid()) @db.Uuid
  visitorId String  @db.Uuid
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  policyVersion String
  /// { essential: true, analytics: true, marketing: false }
  purposes      Json
  granted       Boolean
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  ipHash        String?
  userAgentHash String?

  @@index([visitorId, grantedAt])
  @@map("consents")
}

// ═══════════════════════════════════════════════════════════════════
// ADMIN
// ═══════════════════════════════════════════════════════════════════

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String?  @db.Uuid
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  changes    Json     @default("{}")
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("admin_audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
// CARTÕES PERSONALIZADOS
// ═══════════════════════════════════════════════════════════════════

/// Qual das duas casas de destaque do carrossel.
enum DestaqueDoCarrossel {
  ESQUERDA
  DIREITA
}

/// O recorte da moldura da fotografia no cartão.
enum FormatoDaMoldura {
  CIRCULO
  ELIPSE
  RETANGULO
}

/// Um dos modelos de cartão — DADO, nunca código.
///
/// O cliente escreveu duas vezes que quer poder acrescentar modelos sem pedir
/// programação nova, e é isto que o cumpre: um modelo é uma linha desta tabela.
/// A arte, as medidas da moldura da foto e as medidas da caixa do nome vivem
/// todas aqui, em MILÍMETROS sobre a folha A4.
///
/// MILÍMETROS E NÃO PIXÉIS, de propósito. A folha é medida em milímetros na
/// gráfica e a arte pode chegar com 2480px hoje e 4960px amanhã. Guardar
/// "a moldura começa aos 62 mm" continua verdade nas duas; guardar "aos 732
/// pixéis" deixa de ser verdade assim que o designer reexporta com outra régua.
model ModeloDeCartao {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  slug String
  /// O número que aparece na etiqueta: DIA 1, DIA 2...
  dia  Int
  nome String

  /// O idioma desta arte, em BCP 47: "pt-BR", "en", "es", "fr", "de", "it", "ja".
  ///
  /// O cliente escreveu que vai refazer as mesmas artes noutras línguas. Um
  /// modelo por idioma é o que torna isso um cadastro em vez de um projeto
  /// novo: o Dia 1 em português e o Dia 1 em inglês são duas linhas com o mesmo
  /// `dia` e idiomas diferentes, cada uma com a sua arte.
  ///
  /// A geometria fica em cada linha de propósito. Parece repetição e não é: o
  /// nome "GUILHERME" e o nome "JOHN" não ocupam o mesmo espaço, e a caixa do
  /// nome numa arte alemã quase de certeza terá de ser mais larga. Partilhar as
  /// medidas entre idiomas obrigaria a escolher a pior de todas.
  idioma String @default("pt-BR")

  ativo Boolean @default(true)
  ordem Int     @default(0)

  /// A arte para o ecrã, leve, e a arte para papel, com 2480px ou mais.
  ///
  /// Duas cópias pelo mesmo motivo que já existia nas letras: a de ecrã a
  /// 300 dpi seria um desperdício de dados móveis, e a de papel a 1200px sai
  /// da gráfica com cerca de 124 dpi e nota-se.
  arteUrl          String?
  arteImpressaoUrl String?

  /// A moldura da fotografia, em mm sobre A4 (210 x 297).
  fotoX       Float
  fotoY       Float
  fotoLargura Float
  fotoAltura  Float
  fotoFormato FormatoDaMoldura @default(ELIPSE)

  /// A caixa do nome, em mm sobre A4.
  nomeX           Float
  nomeY           Float
  nomeLargura     Float
  nomeAltura      Float
  nomeCorHex      String  @default("#12356B")
  nomeCorpoMinimo Float   @default(8)
  nomeCorpoMaximo Float   @default(20)
  nomeMaiusculas  Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, ativo, ordem])
  @@index([projectId, idioma, ativo])
  @@map("modelos_de_cartao")
}

/// O preço e o desconto, nas mãos do administrador.
///
/// O cliente foi explícito: "não ficarem presos no código". Uma linha por
/// projeto, editável no painel. Os valores por omissão são os que ele escreveu
/// — R$ 30,00 por conjunto e 30% acima de um conjunto.
model PrecoDeCartoes {
  projectId String  @id @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  precoUnitarioCent   Int    @default(3000)
  moeda               String @default("BRL")
  descontoPercentagem Int    @default(30)
  /// A partir de quantos conjuntos o desconto entra.
  descontoAPartirDe   Int    @default(2)

  atualizadoEm DateTime @updatedAt

  @@map("precos_de_cartoes")
}

/// Por onde o pedido passa, do rascunho ao expurgo.
enum EstadoDoPedido {
  RASCUNHO
  AGUARDANDO_PAGAMENTO
  PAGO
  PRONTO
  EXPIRADO
}

enum MeioDePagamento {
  PIX
  CARTAO
}

/// Uma compra de conjuntos de cartões.
///
/// `expiraEm` NUNCA É NULO, e é a razão de ser desta linha. O cliente pediu
/// que fotos e PDFs não ficassem guardados para sempre, e são fotografias de
/// crianças, com utilizadores em Portugal — RGPD, não só LGPD. Uma data de
/// validade que só existe se alguém se lembrar de a pôr acaba por não existir:
/// aqui ela nasce com o pedido e o expurgo varre por ela.
model PedidoDeCartoes {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  estado EstadoDoPedido @default(RASCUNHO)

  /// O preço fica COPIADO no pedido, não lido da tabela na hora de mostrar.
  /// Se o administrador mudar o preço a meio, quem já estava a comprar paga o
  /// que viu — e o histórico continua a fazer sentido daqui a um ano.
  precoUnitarioCent   Int
  descontoPercentagem Int
  subtotalCent        Int    @default(0)
  descontoCent        Int    @default(0)
  totalCent           Int    @default(0)
  moeda               String @default("BRL")

  meio              MeioDePagamento?
  /// O id que o provedor de pagamento deu a esta cobrança.
  referenciaExterna String?          @unique
  pixCopiaECola     String?
  pixQrSvg          String?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  pagoEm       DateTime?
  prontoEm     DateTime?
  /// Quando a foto e o PDF são apagados do disco.
  expiraEm     DateTime

  criancas           CriancaDoPedido[]
  eventosDePagamento EventoDePagamento[]

  @@index([projectId, estado])
  @@index([expiraEm])
  @@map("pedidos_de_cartoes")
}

/// Uma criança dentro do pedido: uma foto, um nome, um enquadramento.
///
/// O enquadramento é guardado em PROPORÇÃO e não em pixéis — ver
/// `packages/cartoes`. É o que permite que a prévia de 360px no telemóvel e a
/// folha de 2480px na gráfica mostrem exactamente o mesmo recorte.
///
/// Uma linha por criança, e os 7 cartões saem dela. O cliente foi claro: o
/// nome escreve-se uma vez, o enquadramento faz-se uma vez, e aplicam-se aos
/// sete. Guardar sete linhas iguais seria sete sítios para ficarem diferentes.
model CriancaDoPedido {
  id       String          @id @default(uuid()) @db.Uuid
  pedidoId String          @db.Uuid
  pedido   PedidoDeCartoes @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  ordem Int    @default(0)
  nome  String @default("")

  /// O caminho do ficheiro temporário da foto. Apagado pelo expurgo.
  fotoPath    String?
  fotoLargura Int?
  fotoAltura  Int?

  /// O enquadramento, em proporções. 1 é a foto a cobrir a moldura sem zoom.
  escala        Float @default(1)
  deslocX       Float @default(0)
  deslocY       Float @default(0)
  tamanhoDoNome Float @default(0.6)

  /// O veredicto da última avaliação, para o ecrã não ter de recalcular.
  dpi   Int?
  nivel String?

  /// Aprovada pela análise; escolhida pela mãe; confirmada no fim da edição.
  aprovada    Boolean @default(false)
  selecionada Boolean @default(false)
  confirmada  Boolean @default(false)

  /// O PDF dos 7 cartões desta criança. Nasce depois do pagamento, morre no
  /// expurgo.
  pdfPath String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([pedidoId, ordem])
  @@map("criancas_do_pedido")
}

/// Cada aviso que o provedor de pagamento manda.
///
/// `idExterno` é único, e é isso que torna o webhook idempotente. Os provedores
/// reenviam o mesmo aviso quando não recebem resposta a tempo, e um pedido que
/// muda de estado duas vezes por causa do mesmo pagamento é a avaria que só
/// aparece no extrato do cliente.
model EventoDePagamento {
  id       String          @id @default(uuid()) @db.Uuid
  pedidoId String          @db.Uuid
  pedido   PedidoDeCartoes @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  idExterno String @unique
  tipo      String
  bruto     Json   @default("{}")

  recebidoEm DateTime @default(now())

  @@index([pedidoId])
  @@map("eventos_de_pagamento")
}
